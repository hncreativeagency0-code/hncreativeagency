# ─── Frontend (public, safe to expose) ────────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional (public)
VITE_SITE_URL=https://hncreativeagency.pages.dev     # your live domain (canonical URLs, sitemap)
VITE_SUPPORT_EMAIL=support@yourdomain.com           # fallback support email (Admin → Settings overrides it)
VITE_GA_ID=                                         # Google Analytics 4, e.g. G-XXXXXXX
VITE_META_PIXEL_ID=                                 # Meta Pixel ID
VITE_GSC_VERIFICATION=                              # Google Search Console HTML-tag token

# ─── NEVER put these in .env for the frontend or in Git ───────────────
# Set them as Supabase Edge Function secrets:
#   supabase secrets set NAME=value
#
# Calls (pick one TURN option; without TURN, calls use STUN only)
#   CLOUDFLARE_TURN_KEY_ID=
#   CLOUDFLARE_TURN_API_TOKEN=
#   TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
#   TURN_USERNAME=
#   TURN_CREDENTIAL=
#
# Email notifications (Resend)
#   RESEND_API_KEY=
#   EMAIL_FROM="HN Creative Agency <notifications@yourdomain.com>"
#   WEBHOOK_SECRET=long-random-string
#
# Online payment gateway (only after your merchant account is approved)
#   PAYMENT_PROVIDER=safepay
#   PAYMENT_WEBHOOK_SECRET=
#   PAYMENT_API_KEY=
#   PAYMENT_API_BASE=
#
# WhatsApp alerts (WhatsApp Cloud API)
#   WHATSAPP_TOKEN=
#   WHATSAPP_PHONE_ID=
#   WHATSAPP_TEMPLATE=order_update
#
# Shared
#   SITE_URL=https://hncreativeagency.pages.dev
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into edge functions automatically by Supabase — do not set them yourself.
